  "id": "cool-blue-glitch",
  "name": {
    "zh": "掉进冷蓝漫画频道",
    "en": "Cool Blue Comic Signal"
  },
  "summary": {
    "zh": "冷蓝色块与珊瑚暖色交错，重绘带有错版与信号失真的动漫场景。",
    "en": "Cool blue planes and warm coral accents redraw daily scenes with comic print misregistration."
  },
  "suitability": {
    "zh": "适合主体、动作和场景关系清楚的人像照片。会明显重绘形体和环境，不承诺摄影级相似；极复杂多人场景待验证。",
    "en": "Choose a readable portrait, pose and setting. This recipe deliberately redraws shapes and scenery; photographic likeness is not promised."
  },
  "tags": [
    "comic",
    "portrait",
