{
  "schemaVersion": 1,
  "id": "indie-ink-portrait",
  "name": {
    "zh": "把自己画进独立漫画",
    "en": "Indie Ink Portrait"
  },
  "summary": {
    "zh": "粗墨线与黑白留白，把熟悉的神态重画成独立漫画角色。",
    "en": "Bold ink and quiet white space turn familiar expressions into indie comic characters."
  },
  "suitability": {
    "zh": "适合脸部与发型清晰的单人头像、半身照；保留原有表情和识别特征。多人及复杂遮挡待实测。",
    "en": "Best for a clear single-person portrait or upper-body photo. Groups and heavy occlusion remain untested."
  },
